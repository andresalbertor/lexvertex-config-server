# Plantilla PDN (sin secretos). Copia a config-server.pdn.env y rellena la password.

CONFIG_SERVER_PROFILE=jdbc
CONFIG_REPO_PATH=file:/config-repo

DB_CONFIG_URL=jdbc:mysql://mysql:3306/lex_config?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
DB_CONFIG_USER=lex_config_app
DB_CONFIG_PASSWORD=

MYSQL_CONFIG_APP_USER=lex_config_app
MYSQL_CONFIG_APP_PASSWORD=

EUREKA_URL=http://discovery-service:8761/eureka/
EUREKA_INSTANCE_HOSTNAME=config-server
