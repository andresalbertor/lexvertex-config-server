# Config Server — DEV (local / bootRun / docker compose local)
# Uso: exportar estas vars o copiar a .env.local (raíz LexVertex).
# Bootstrap del servicio: solo src/main/resources/application.yml
# Fuente de verdad de MS: MySQL lex_config.PROPERTIES (perfil jdbc). Nunca lex_core.

CONFIG_SERVER_PROFILE=jdbc
CONFIG_REPO_PATH=file:../../../config-repo

# JDBC dedicado (usuario solo SELECT sobre lex_config)
DB_CONFIG_URL=jdbc:mysql://localhost:3306/lex_config?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
DB_CONFIG_USER=lex_config_app
DB_CONFIG_PASSWORD=lex_config_dev

# Alias usados por scripts/compose al crear el usuario MySQL
MYSQL_CONFIG_APP_USER=lex_config_app
MYSQL_CONFIG_APP_PASSWORD=lex_config_dev

# Eureka (local)
EUREKA_URL=http://localhost:8761/eureka/
EUREKA_INSTANCE_HOSTNAME=localhost

# Puerto fijo 8888 en application.yml (no definir server.port aqui:
# loaders de .env tratan "# clave=valor" como variable y rompen el arranque).
